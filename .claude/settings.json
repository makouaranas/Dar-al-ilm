{
  "env": {
    "PLAYWRIGHT_MCP_BROWSER": "chromium",
    "PLAYWRIGHT_MCP_EXECUTABLE_PATH": "/opt/pw-browsers/chromium",
    "PLAYWRIGHT_MCP_HEADLESS": "true",
    "PLAYWRIGHT_MCP_NO_SANDBOX": "true",
    "PLAYWRIGHT_MCP_ISOLATED": "true",
    "PLAYWRIGHT_MCP_VIEWPORT_SIZE": "1440x900"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@anthropic-plugin-directory": true,
    "playwright@anthropic-plugin-directory": true,
    "context7@anthropic-plugin-directory": true,
    "typescript-lsp@anthropic-plugin-directory": true,
    "pyright-lsp@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {}
}
